\BLOCK{ endfor }
\end{tabular}
\end{center}

\begin{examplebox}{Reading the grid as a division fact}
Find $72 \div 8$. Look for 72 inside the grid: it's in row 8, column 9. So $72 \div 8 = 9$ (and, reading the other way, $72 \div 9 = 8$). Every multiplication fact gives you two division facts for free.
\end{examplebox}

