\section{Geometry \& Shape}

\subsection*{Geometry \& Angles}
\VAR{ outcomes('geometry_angles') }

\begin{stepsbox}
\begin{enumerate}[label=\arabic*.]
  \item \textbf{Classify}: acute $<90^\circ$, right $=90^\circ$, obtuse between $90^\circ$ and $180^\circ$, straight $=180^\circ$, reflex $>180^\circ$.
  \item Angles on a \textbf{straight line} always add to $180^\circ$.
  \item Angles inside a \textbf{triangle} always add to $180^\circ$.
\end{enumerate}
\end{stepsbox}

\begin{examplebox}{Classifying a $50^\circ$ angle}
\begin{center}
\begin{tikzpicture}[scale=0.8]
  \draw[thick,<->] (2,0) -- (0,0) -- (50:2);
  \draw[fill=gray!25] (0,0) -- (0.5,0) arc (0:50:0.5) -- cycle;
  \node at (0.75,0.3) {$50^\circ$};
\end{tikzpicture}
\end{center}
$50^\circ$ is less than $90^\circ$, so this is an \textbf{acute} angle.
\end{examplebox}

\begin{examplebox}{Missing angle on a straight line}
One angle on a straight line measures $65^\circ$. The other angle $x$: $x = 180^\circ - 65^\circ = \mathbf{115^\circ}$.
\end{examplebox}

\begin{examplebox}{Missing angle in a triangle}
Two angles of a triangle measure $50^\circ$ and $60^\circ$. The third angle $x$: $x = 180^\circ-(50^\circ+60^\circ)=\mathbf{70^\circ}$.
\end{examplebox}

\subsection*{2D Shapes}
\VAR{ outcomes('2d_shapes') }

Shapes are classified by their number of sides (triangle 3, quadrilateral 4, pentagon 5, hexagon 6\ldots), and quadrilaterals further by their side/angle properties (rhombus: 4 equal sides; parallelogram: 2 pairs of parallel sides; trapezium: 1 pair of parallel sides). Triangles are classified by side length: equilateral (3 equal), isosceles (2 equal), scalene (none equal).

\begin{examplebox}{Composite area (L-shaped figure)}
\begin{center}
\begin{tikzpicture}[scale=0.5]
  \draw[thick] (0,0) -- (8,0) -- (8,5) -- (4,5) -- (4,3) -- (0,3) -- cycle;
  \node at (4,-0.5) {8 cm};
  \node[rotate=90] at (-0.5,1.5) {3 cm};
  \node at (6,5.5) {4 cm};
  \node[rotate=90] at (8.5,2.5) {5 cm};
\end{tikzpicture}
\end{center}
Split it into two rectangles: $R_1 = 8\times3=24$ and $R_2=4\times2=8$ (the remaining height above $R_1$ is $5-3=2$). Total area $= 24+8=\mathbf{32\text{ cm}^2}$.
\end{examplebox}

\subsection*{3D Objects}
\VAR{ outcomes('3d_objects') }

3D objects have \textbf{faces} (flat surfaces), \textbf{edges} (where two faces meet) and \textbf{vertices} (corners). A cube has 6 square faces; a rectangular prism has 6 rectangular faces; a triangular pyramid has 4 triangular faces.

\begin{examplebox}{Volume \& capacity of a rectangular tank}
\begin{center}
\begin{tikzpicture}[scale=0.7]
  \draw (0,0) rectangle (3,2);
  \draw (1,1) rectangle (4,3);
  \draw (0,0)--(1,1); \draw (3,0)--(4,1); \draw (3,2)--(4,3); \draw (0,2)--(1,3);
  \node at (1.5,-0.4) {6 cm};
  \node[rotate=90] at (-0.4,1) {4 cm};
  \node at (3.9,0.3) {10 cm};
\end{tikzpicture}
\end{center}
Volume $= l\times w\times h = 6\times4\times10=240\text{ cm}^3$. Since $1{,}000\text{ cm}^3=1$ litre: capacity $=240\div1000=\mathbf{0.24\text{ L}}$.
\end{examplebox}

