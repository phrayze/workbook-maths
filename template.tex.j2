\documentclass[\VAR{font_size | default('12pt')}, a4paper]{extarticle}
\usepackage[margin=2cm]{geometry}
\usepackage{amsmath, amssymb}
\usepackage{xlop}          % Column arithmetic
\usepackage{enumitem}      % Lists
\usepackage{tikz}          % Clock faces and angle diagrams
\usepackage{fancyhdr}
\usepackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% Column-arithmetic spacing (independent of font_size - see config.yaml's
% arithmetic_column_width/arithmetic_line_height): columnwidth is the
% horizontal gap between digit columns, lineheight the vertical gap between
% rows, in \opadd/\opsub/\opmul/\opidiv.
\opset{columnwidth=\VAR{arithmetic_column_width | default('2ex')}, lineheight=\VAR{arithmetic_line_height | default(1.0)}\baselineskip}

% Section heading: a navy title bar over a light grey instruction box,
% independent of the body font_size so it never grows large enough to wrap
% or collide with anything else on the page.
\definecolor{sectionnavy}{RGB}{21,54,95}
\newtcolorbox{sectionbox}[1]{colback=gray!6!white, colframe=sectionnavy, coltitle=white,
  fonttitle=\bfseries\large, title={#1}, fontupper=\normalsize,
  arc=2mm, boxrule=0.8pt, left=8pt, right=8pt, top=5pt, bottom=5pt, breakable}

% Header/footer text is pinned to a fixed size regardless of font_size, so a
% larger body font_size can never make the left/right header text wide
% enough to collide (this was happening at every font_size, worse at larger
% ones, before this fix).
\setlength{\headheight}{22pt}
\pagestyle{fancy}
\fancyhead[L]{\fontsize{10pt}{12pt}\selectfont \VAR{header_left}}
\fancyhead[R]{\fontsize{10pt}{12pt}\selectfont Name: \underline{\hspace{3.5cm}} Date: \underline{\hspace{2.5cm}}}
\fancyfoot[C]{\fontsize{10pt}{12pt}\selectfont Page \thepage}

\begin{document}

\begin{center}
    {\LARGE \bfseries \VAR{title}} \\[0.5em]
    \BLOCK{ if subtitle }
    {\small \VAR{subtitle}}
    \BLOCK{ endif }
\end{center}
\vspace{1em}

\BLOCK{ for sec in sections }
\begin{sectionbox}{\VAR{sec.title}}
\VAR{sec.description}
\end{sectionbox}
\vspace{0.6em}

\BLOCK{ if sec.layout == 'grid_3col' }
\noindent%
\BLOCK{ for q in sec.questions }%
\begin{minipage}[t]{0.3\textwidth}
    \centering
    \textbf{Q\VAR{q.id}:}\\[0.5em]
    \VAR{q.prompt_tex}
    \vspace{\VAR{sec.working_space}}
\end{minipage}%
\BLOCK{ if loop.index % 3 == 0 }

\vspace{1.5em}
\noindent%
\BLOCK{ else }%
\hfill%
\BLOCK{ endif }%
\BLOCK{ endfor }

\vspace{2em}

\BLOCK{ else }
\BLOCK{ for q in sec.questions }
\noindent\begin{minipage}{\linewidth}
\hangindent=2em\hangafter=1
\textbf{Q\VAR{q.id}:}\hspace{0.5em}\VAR{q.prompt_tex}
\vspace{\VAR{sec.working_space}}
\end{minipage}
\BLOCK{ if not loop.last }

\vspace{0.8em}

\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endif }

\BLOCK{ endfor }

\BLOCK{ if include_solutions }
\newpage
% ANSWER KEY PAGE
\fancyhead[L]{\fontsize{10pt}{12pt}\selectfont \VAR{header_left} -- Worked Solutions}

\begin{center}
    {\LARGE \bfseries Answer Key \& Solutions Guide}
\end{center}
\vspace{1em}

\BLOCK{ for q in all_questions }
\begin{tcolorbox}[colback=gray!5!white,colframe=gray!75!black,title=Question \VAR{q.id} -- \VAR{q.section} \BLOCK{ if q.outcome_code }[\VAR{q.outcome_code}]\BLOCK{ endif }]
    \BLOCK{ if q.capability }
    {\small \textbf{NESA Outcome Capability:} \VAR{q.capability}}\\[0.5em]
    \BLOCK{ endif }
    \textbf{Solution:} \VAR{q.solution_tex}
\end{tcolorbox}
\BLOCK{ endfor }
\BLOCK{ endif }

\end{document}